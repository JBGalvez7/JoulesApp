            </Label>
            <Label prefHeight="18.0" prefWidth="105.0" snapToPixel="false" text="Email Address:">
               <padding>
                  <Insets left="10.0" />
               </padding>
            </Label>
            <Label prefHeight="18.0" prefWidth="105.0" snapToPixel="false" text="Address:">
               <padding>
                  <Insets left="10.0" />
               </padding>
            </Label>
            <Label prefHeight="18.0" prefWidth="105.0" snapToPixel="false" text="Phone Number:">
               <padding>
                  <Insets left="10.0" />
